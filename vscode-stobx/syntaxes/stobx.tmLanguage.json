{
  "scopeName": "source.stobx",
  "patterns": [
    {
      "name": "comment.line.double-slash.stobx",
      "match": "//.*$"
    },
    {
      "name": "comment.block.stobx",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.stobx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.stobx",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.stobx",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.stobx",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.hex.stobx",
      "match": "\\b0[xX][0-9a-fA-F_]+\\b"
    },
    {
      "name": "constant.numeric.binary.stobx",
      "match": "\\b0[bB][01_]+\\b"
    },
    {
      "name": "constant.numeric.stobx",
      "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9_]+)?\\b"
    },
    {
      "name": "constant.language.stobx",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "storage.type.primitive.stobx",
      "match": "\\b(u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f32|f64|bool|char|void)\\b"
    },
    {
      "name": "keyword.control.stobx",
      "match": "\\b(if|else|else\\s+if|else_if|match|while|for|loop|break|continue|return)\\b"
    },
    {
      "name": "keyword.operator.logical.stobx",
      "match": "\\b(not|and|or)\\b"
    },
    {
      "name": "keyword.operator.word.stobx",
      "match": "\\b(as|sizeof)\\b"
    },
    {
      "name": "storage.modifier.stobx",
      "match": "\\b(mut|const|static|extern)\\b"
    },
    {
      "name": "keyword.other.stobx",
      "match": "\\b(let|type|do|fn|struct|union|enum|impl|self|module|import)\\b"
    },
    {
      "name": "support.function.stobx",
      "match": "\\b(pri|delete|copy|move)\\b"
    },
    {
      "name": "entity.name.function.stobx",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.stobx",
      "match": "<<=|>>=|==|!=|>=|<=|<<|>>|->|=>|\\.\\.\\.|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|&&|\\|\\||[+\\-*/%=<>!&|^~?@]"
    },
    {
      "name": "punctuation.accessor.scope.stobx",
      "match": "::"
    },
    {
      "name": "punctuation.terminator.stobx",
      "match": "\\.\\."
    },
    {
      "name": "variable.other.stobx",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ]
}

